{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/verification-gate.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/verification-gate.mjs')\"",
            "timeout": 30,
            "statusMessage": "Contrôle de la preuve de validation"
          }
        ]
      }
    ]
  }
}
