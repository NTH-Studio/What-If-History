{
  "name": "what-if-history",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @what-if-history/server\" \"npm run dev -w @what-if-history/web\"",
    "build": "npm run build -w @what-if-history/server && npm run build -w @what-if-history/web",
    "start": "npm run start -w @what-if-history/server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "guard": "node scripts/quality-guard.mjs",
    "db:migrate": "npm run db:migrate -w @what-if-history/server",
    "check": "npm run guard && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm audit --omit=dev --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
